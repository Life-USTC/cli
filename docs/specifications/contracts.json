    {
      "id": "openapi.cli-generated-business-client",
      "scope": "all",
      "rationale": "Covered CLI business operations call the generated OpenAPI client with generated request parameters and bodies, and decode the operation’s declared response model before rendering. The explicit raw API command and external school/OAuth transports have separate responsibilities.",
      "test": {
        "file": "internal/cmd/root/semantic_contract_test.go",
        "name": "TestSpecGeneratedBusinessClients/openapi.cli-generated-business-client"
      },
      "expectations": {
        "kind": "architecture",
        "cases": [
          {
            "id": "generated-calls",
            "action": "architecture",
            "want": {
              "violations": 0,
              "minimumCalls": 1
            }
          },
          {
            "id": "valid-response",
            "action": "publication",
            "operation": "get-api-publications",
            "arguments": [
              "--type",
              "notice",
              "--limit",
              "2"
            ],
            "format": "json",
            "fixture": "publication",
            "want": {
              "error": false,
              "requests": 1,
              "outputEmpty": false,
              "preserve": [
                "/data/0/id",
                "/data/0/revision/summary"
              ]
            }
          },
          {
            "id": "invalid-response",
            "action": "publication",
            "operation": "get-api-publications",
            "arguments": [
              "--type",
              "notice",
              "--limit",
              "2"
            ],
            "format": "json",
            "fixture": "publication",
            "want": {
              "error": true,
              "requests": 1,
              "outputEmpty": true
            },
            "malformed": true
          }
        ]
      }
    },
    {
      "id": "cli.admin-session-boundary",
      "scope": "private",
      "rationale": "CLI OAuth authorization does not support administrator governance; those operations are available only through browser-session Web administration.",
      "test": {
        "file": "internal/cmd/root/semantic_contract_test.go",
        "name": "TestSpecAdminSessionBoundary/cli.admin-session-boundary"
      },
      "expectations": {
        "kind": "availability",
        "cases": [
          {
            "id": "admin-removed",
            "action": "admin",
            "arguments": [
              "admin",
              "user",
              "list"
            ],
            "want": {
              "error": true,
              "absent": [
                "admin"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "cli.bus-preference-partial-update",
      "scope": "private",
      "rationale": "Changing one bus preference flag preserves unspecified saved preferences. Failure to read existing preferences aborts the update.",
      "test": {
        "file": "internal/cmd/root/semantic_contract_test.go",
        "name": "TestSpecBusPreferencePartialUpdate/cli.bus-preference-partial-update"
      },
      "expectations": {
        "kind": "mutation",
        "cases": [
          {
            "id": "preserve-unspecified",
            "action": "bus-partial",
            "operation": "workspace_bus_preferences_get",
            "arguments": [
              "--destination",
              "3"
            ],
            "format": "json",
            "fixture": "busget",
            "failurePage": 0,
            "want": {
              "error": false,
              "requests": 2,
              "writes": 1,
              "preserve": [
                "/preferredOriginCampusId",
                "/showDepartedTrips"
              ],
              "changed": {
                "preferredDestinationCampusId": 3
              }
            }
          },
          {
            "id": "failed-read",
            "action": "bus-partial",
            "operation": "workspace_bus_preferences_get",
            "arguments": [
              "--destination",
              "3"
            ],
            "format": "json",
            "fixture": "busget",
            "failurePage": 1,
            "want": {
              "error": true,
              "requests": 1,
              "writes": 0,
              "preserve": [],
              "changed": {}
            },
            "failureStatus": 401
          }
        ]
      }
    },
    {
      "id": "cli.bus-preference-json-input",
      "scope": "private",
      "rationale": "Bus preference raw JSON accepts exactly one generated request object and rejects null, unknown fields, wrong types and trailing input before mutation.",
