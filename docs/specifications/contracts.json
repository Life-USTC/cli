    {
      "id": "room-map.cli-input",
      "scope": "public",
      "rationale": "Room codes are trimmed and empty codes are rejected.",
      "test": {
        "file": "internal/cmd/room/room_test.go",
        "name": "TestSpecNormalizeRoomCodeTrimsAndRejectsEmpty/room-map.cli-input"
      },
      "expectations": {
        "kind": "normalization",
        "cases": [
          {
            "id": "trim",
            "action": "normalize",
            "want": {
              "error": false,
              "value": "西区"
            },
            "value": "  西区  "
          },
          {
            "id": "empty",
            "action": "normalize",
            "want": {
              "error": true,
              "value": ""
            },
            "value": "   "
          }
        ]
      }
