            "fixture": "exam",
            "count": 104,
            "failurePage": 2,
            "want": {
              "error": true,
              "requests": 2,
              "outputEmpty": true
            },
            "failureStatus": 403
          }
        ]
      }
    },
    {
      "id": "exam.cli-positive-input",
      "scope": "private",
      "rationale": "Explicit page, limit and semester identifiers must be positive; limit is at most 100.",
      "test": {
        "file": "internal/cmd/workspace/exam_test.go",
        "name": "TestSpecExamRejectsInvalidExplicitPaginationAndSemester/exam.cli-positive-input"
      },
      "expectations": {
        "kind": "input",
        "cases": [
          {
            "id": "zero-page",
            "action": "exam",
            "operation": "workspace_exam_list",
            "arguments": [
              "--page",
              "0"
            ],
            "format": "json",
            "want": {
              "error": true,
              "requests": 0,
              "outputEmpty": true
            }
          },
          {
            "id": "zero-limit",
            "action": "exam",
            "operation": "workspace_exam_list",
            "arguments": [
              "--limit",
              "0"
            ],
            "format": "json",
            "want": {
              "error": true,
              "requests": 0,
              "outputEmpty": true
            }
          },
          {
            "id": "zero-semester",
            "action": "exam",
            "operation": "workspace_exam_list",
            "arguments": [
              "--semester-id",
              "0"
            ],
            "format": "json",
            "want": {
              "error": true,
              "requests": 0,
              "outputEmpty": true
            }
          },
          {
            "id": "negative-page",
            "action": "exam",
            "operation": "workspace_exam_list",
            "arguments": [
              "--page",
              "-1"
            ],
            "format": "json",
            "want": {
              "error": true,
              "requests": 0,
              "outputEmpty": true
            }
