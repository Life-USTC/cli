    {
      "id": "exam.cli-explicit-pagination",
      "scope": "private",
      "rationale": "Explicit page or limit flags select one REST page without auto-fetching further pages.",
      "test": {
        "file": "internal/cmd/workspace/exam_test.go",
        "name": "TestSpecExamExplicitPaginationAndFilters/exam.cli-explicit-pagination"
      },
      "expectations": {
        "kind": "collection",
        "cases": [
          {
            "id": "page-only",
            "action": "exam",
            "operation": "workspace_exam_list",
            "arguments": [
              "--page",
              "2",
              "--semester-id",
              "7",
              "--date-from",
              "2026-09-01",
              "--date-to",
              "2026-09-30",
              "--include-date-unknown=false"
            ],
            "format": "json",
            "fixture": "exam",
            "count": 24,
            "failurePage": 0,
            "want": {
              "error": false,
              "requests": 1,
              "outputEmpty": false,
              "rowCount": 4,
              "total": 24,
              "identities": [
                "21",
                "22",
                "23",
                "24"
              ]
            }
          },
          {
            "id": "limit-only",
            "action": "exam",
            "operation": "workspace_exam_list",
            "arguments": [
              "--limit",
              "2"
            ],
            "format": "json",
            "fixture": "exam",
            "count": 4,
            "failurePage": 0,
            "want": {
              "error": false,
              "requests": 1,
              "outputEmpty": false,
              "rowCount": 2,
              "total": 4,
              "identities": [
                "1",
                "2"
              ]
            }
          },
          {
            "id": "page-and-limit",
            "action": "exam",
            "operation": "workspace_exam_list",
            "arguments": [
              "--page",
              "2",
              "--limit",
              "2"
            ],
            "format": "json",
            "fixture": "exam",
            "count": 4,
            "failurePage": 0,
            "want": {
              "error": false,
              "requests": 1,
              "outputEmpty": false,
              "rowCount": 2,
              "total": 4,
              "identities": [
                "3",
                "4"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "exam.cli-page-failure",
      "scope": "private",
      "rationale": "A failed later exam page fails the command without printing partial results.",
      "test": {
        "file": "internal/cmd/workspace/exam_test.go",
        "name": "TestSpecExamLaterPageFailureDoesNotPrintPartialSuccess/exam.cli-page-failure"
      },
      "expectations": {
